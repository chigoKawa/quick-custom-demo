{
  "defaultProvider": "mock",
  "providers": {
    "mock": {
      "name": "Mock Auth",
      "enabled": true,
      "useMock": true,
      "simulateLatency": true,
      "demoUser": {
        "email": "demo@example.com",
        "password": "demo123",
        "name": "Demo User"
      }
    },
    "auth0": {
      "name": "Auth0",
      "enabled": false,
      "domain": "${AUTH0_DOMAIN}",
      "endpoints": {
        "authorize": "/authorize",
        "token": "/oauth/token",
        "userInfo": "/userinfo"
      },
      "credentials": {
        "clientId": "${AUTH0_CLIENT_ID}",
        "clientSecret": "${AUTH0_CLIENT_SECRET}"
      }
    },
    "okta": {
      "name": "Okta",
      "enabled": false,
      "domain": "${OKTA_DOMAIN}",
      "endpoints": {
        "authorize": "/oauth2/v1/authorize",
        "token": "/oauth2/v1/token",
        "userInfo": "/oauth2/v1/userinfo"
      },
      "credentials": {
        "clientId": "${OKTA_CLIENT_ID}",
        "clientSecret": "${OKTA_CLIENT_SECRET}"
      }
    }
  }
}
