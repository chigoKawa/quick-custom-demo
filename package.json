{
  "name": "dev-basic-example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' next dev --turbopack",
    "contentful:bootstrap-site-settings": "node scripts/contentful/bootstrap-site-settings.mjs",
    "contentful:cli-export": "contentful space export --space-id $CTF_SPACE_ID --environment-id $CTF_ENVIRONMENT --content-file $CTF_EXPORT_FILE --content-only false --include-drafts",
    "contentful:cli-import": "contentful space import --space-id $CTF_SPACE_ID --environment-id $CTF_ENVIRONMENT --content-file $CTF_EXPORT_FILE",
    "build:kb-index": "node scripts/kb/build-kb-index.mjs",
    "build:redirects": "node scripts/generate-redirects.mjs",
    "build": "node lib/fetchLocales.mjs && node scripts/generate-redirects.mjs && node scripts/kb/build-kb-index.mjs && next build",
    "start": "next start",
    "build:functions": "contentful-app-scripts build-functions",
    "ctf-app:build": "node scripts/build-ctf-app.mjs",
    "ctf-app:upload": "node scripts/build-ctf-app.mjs --upload",
    "lint": "next lint",
    "sitemap": "node scripts/generate-sitemap.mjs"
  },
